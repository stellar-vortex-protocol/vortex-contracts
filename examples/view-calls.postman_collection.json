{
  "info": {
    "name": "Vortex intent_settlement read-only views",
    "description": "Example Stellar RPC simulateTransaction requests for every read-only view in intent_settlement/src/lib.rs. Generate each *_tx_xdr value with the Stellar CLI against your deployed contract, then import this collection into Postman, Insomnia, or any tool that accepts Postman collections.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "rpc_url",
      "value": "https://soroban-testnet.stellar.org"
    },
    {
      "key": "contract_id",
      "value": "REPLACE_WITH_DEPLOYED_CONTRACT_ID"
    },
    {
      "key": "source_account",
      "value": "REPLACE_WITH_PUBLIC_KEY_USED_TO_BUILD_TX"
    }
  ],
  "item": [
    {
      "name": "get_protocol_params",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{rpc_url}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": \"get_protocol_params\",\n  \"method\": \"simulateTransaction\",\n  \"params\": { \"transaction\": \"{{get_protocol_params_tx_xdr}}\" }\n}"
        },
        "description": "Build XDR for: stellar contract invoke --id {{contract_id}} --source {{source_account}} --network testnet -- get_protocol_params"
      }
    },

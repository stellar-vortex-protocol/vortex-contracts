# Soroban RPC endpoint to connect to
SOROBAN_RPC_URL=http://localhost:8001

# Intent Settlement contract ID to watch for events
# Get this from your contract deployment (e.g., stellar contract deploy ...)
CONTRACT_ID=CDAA...

# Webhook URL to POST events to
# This endpoint will receive JSON payloads for each contract event
WEBHOOK_URL=https://your-backend.example.com/vortex/events

# Maximum number of retry attempts for failed webhook deliveries
# Default: 3
MAX_RETRIES=3

# Milliseconds to wait before first retry (exponential backoff applied)
# Default: 1000
RETRY_BACKOFF_MS=1000

# Express server port for health checks and stats
# Default: 3000
PORT=3000

# Logging level: debug, info, warn, error
# Default: info
LOG_LEVEL=info

# Optional: ledger sequence to start event polling from
# If not set, starts from the next new event
# STARTING_CURSOR=123456

# Optional: Node environment
# NODE_ENV=production

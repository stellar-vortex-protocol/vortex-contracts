{
  "name": "@vortex-protocol/events-webhook-relay",
  "version": "0.1.0",
  "description": "Example event relay service for Vortex Protocol - subscribe to contract events and forward to webhooks",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js",
    "build": "tsc",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "express": "^4.18.2",
    "js-stellar-sdk": "^11.0.0",
    "dotenv": "^16.0.3",
    "axios": "^1.4.0",
    "pino": "^8.10.0",
    "pino-pretty": "^10.1.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "eslint": "^8.40.0",
    "prettier": "^2.8.8"
  },
  "keywords": [
    "vortex",
    "stellar",
    "soroban",
    "webhook",
    "event-relay",
    "example"
  ],
  "license": "MIT"
}
